SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SNMP_COMMUNITY=public
SNMP_VERSION=2c
SNMP_PORT=161
POLL_INTERVAL_MINUTES=60
LOG_LEVEL=INFO

# Site filter — only poll printers whose IP starts with this prefix.
# Leave blank to poll all printers in the DB.
#   Baker Street:  POLL_IP_PREFIX=192.168.21.
#   Rainbow Park:  POLL_IP_PREFIX=192.168.20.
POLL_IP_PREFIX=
